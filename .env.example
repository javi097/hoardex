# RAWG Video Games API (https://rawg.io/apidocs)
# Obtén tu clave gratuita registrándote en RAWG
VITE_RAWG_API_KEY=tu_clave_de_rawg_aqui

# BoardGameGeek API (opcional)
# Token Bearer si dispones de acceso autenticado o proxy registrado en BGG
VITE_BGG_API_TOKEN=

# Supabase (Fase 4: Sincronización Cloud y Autenticación)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui
